{
  "name": "attendo",
  "version": "1.0.0",
  "private": true,
  "description": "Attendance & invoicing app for coaches and instructors",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.0"
  },
  "scripts": {
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "migrate": "node migrations/run.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test:db:setup": "node scripts/setup-test-db.js",
    "test:api": "npm run test:db:setup && vitest run --project server",
    "test:unit": "vitest run --project client",
    "test": "npm run test:api && npm run test:unit"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "supertest": "^7.2.2",
    "vitest": "^4.1.10"
  }
}
