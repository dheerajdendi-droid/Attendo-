DATABASE_URL=postgres://attendo:attendo_dev_password@localhost:5432/attendo
SESSION_SECRET=change-me-to-a-long-random-string
PORT=4000
NODE_ENV=development

# Social sign-in — the app works fine without these (PIN-only fallback).
# Set these to enable "Continue with Google" / "Continue with Facebook" on
# the lock screen. OWNER_EMAIL gates both providers to a single account.
OWNER_EMAIL=you@example.com
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
